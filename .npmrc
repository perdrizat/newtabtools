# Supply-chain — refuse to install package versions less than 7 days old.
# pnpm-native setting (npm 11 silently ignores it; the preinstall hook
# in package.json blocks npm/yarn from being used at all).
minimum-release-age=604800

# Fail install if Node/pnpm engines in package.json don't match.
engine-strict=true

# pnpm 9+: auto-install peerDependencies (sane default; matches npm behavior).
auto-install-peers=true
