{
	"name": "__MSG_extensionName__",
	"description": "__MSG_extensionDescription__",
	"version": "2.0.3",
	"icons": {
		"48": "images/icon.svg"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "newtabtools@symlink.ch",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	},
	"chrome_url_overrides": {
		"newtab": "newTab.xhtml"
	},
	"background": {
		"scripts": [
			"common.js",
			"tiles.js",
			"prefs.js",
			"background.js",
			"lib/zip.js",
			"export.js"
		]
	},
	"browser_action": {
		"default_icon": "images/tools-light.svg",
		"theme_icons": [
			{
				"dark": "images/tools-light.svg",
				"light": "images/tools-dark.svg",
				"size": 16
			}
		],
		"default_popup": "action.html",
		"default_title": "__MSG_extensionName__",
		"browser_style": true
	},
	"permissions": [
		"<all_urls>",
		"idle",
		"menus",
		"search",
		"sessions",
		"storage",
		"tabs",
		"topSites",
		"webNavigation",
		"webRequest"
	],
	"optional_permissions": [
		"bookmarks",
		"downloads",
		"history"
	],
	"default_locale": "en",
	"manifest_version": 2,
	"content_security_policy": "script-src 'self'; object-src 'none'; connect-src 'self' https://firefox.settings.services.mozilla.com; img-src 'self' blob: data: https: https://firefox-settings-attachments.cdn.mozilla.net"
}
